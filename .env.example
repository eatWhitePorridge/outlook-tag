# 必填：会话签名密钥（请用足够长的随机串）
SECRET_KEY=change-me-to-a-long-random-string

# 必填：管理端登录密码
ADMIN_PASSWORD=change-me

# SQLite 路径
# 本地开发示例：backend/data/mail.db
# Docker 部署由 compose 强制为 /app/data/mail.db，一般无需改
DB_PATH=backend/data/mail.db

# CORS：Docker 同域部署（浏览器只访问一个端口）可留空
# 本地前后端分离开发时填前端源
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 经 HTTPS 反代时设为 true（管理 Cookie 带 Secure）
COOKIE_SECURE=false

# 宿主机映射端口（仅 docker compose）
HOST_PORT=8080
